+"""Account-scoped read of existing agent events; never contacts Ozonetel."""
+from datetime import datetime, timedelta, timezone
+import re
+from cloud.database import connection
+from integrations.dialer.policy import IST
+
+MAX_EVENTS = 20000
+
+
+def read_history(account, date, now=None):
+    now = now or datetime.now(timezone.utc)
+    if not isinstance(date, str) or not re.fullmatch(r'\d{4}-\d{2}-\d{2}', date):
+        raise ValueError('Invalid date')
+    start = datetime.strptime(date, '%Y-%m-%d').replace(tzinfo=IST)
+    age = (now.astimezone(IST).date() - start.date()).days
+    if not 0 <= age < 30:
+        raise ValueError('Date outside retained history')
+    through = min(now, start + timedelta(days=1))
+    with connection() as db:
+        db.execute('SET TRANSACTION READ ONLY')
+        db.execute("SET LOCAL statement_timeout='8s'")
+        rows = db.execute("""SELECT agent, occurred_at,
+            COALESCE(payload->'data'->>'agentMode',payload->'data'->>'agent_mode',''),
+            COALESCE(payload->'data'->>'action','')
+            FROM integration_events
+            WHERE kind='agent' AND lower(payload->>'username')=%s
+            AND occurred_at >= %s AND occurred_at <= %s
+            ORDER BY occurred_at,id LIMIT %s""",
+            (account.casefold(), start.timestamp(), through.timestamp(), MAX_EVENTS+1)).fetchall()
+    if len(rows) > MAX_EVENTS:
+        return dict(ok=False, date=date, truncated=True, error='Mode history exceeds response bound')
+    events = [dict(agentId=str(agent), at=datetime.fromtimestamp(at, timezone.utc).isoformat(),
+                   mode=str(mode or '')[:40], action=str(action or '')[:40])
+              for agent, at, mode, action in rows if agent and at > 0]
+    return dict(ok=True, date=date, through=through.isoformat(), events=events, truncated=False)
