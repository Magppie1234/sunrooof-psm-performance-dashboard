# Required: HTTPS base URL of the existing shared Ozonetel backend.
PSM_INTEGRATION_URL=

# Required secret: report-client key issued by that shared backend.
# This is NOT an Ozonetel API key. Keep it server-side only.
PSM_INTEGRATION_KEY=

# Required: CloudAgent account username, matching this backend client's account.
OZONETEL_USERNAME=

# Optional settings; leave commented out unless used in Vercel.
# OZONETEL_AGENT_IDS=
# OZONETEL_MODE_TYPES=
# DASHBOARD_PASSWORD=

# Ozonetel API keys, tokens, encryption keys and rate budgets belong to the
# separate shared backend. They are not required by this dashboard.
